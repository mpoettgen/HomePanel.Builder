@page "/"
@using HomePanel.Builder.Client.Components
@using HomePanel.Builder.Client.Models
@using HomePanel.Builder.Client.Services
@attribute [StreamRendering]
@inject IPanelDesignsProvider PanelDesignsProvider

<PageTitle>Home Panel Builder</PageTitle>

@if (Designs == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <div class="container-fluid">
        <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 row-cols-xxl-6 g-4">
            @foreach (DesignInfo design in Designs)
            {
            <div class="col">
                <div class="card h-100">
                    <div class="card-body">
                        <h5 class="card-title">@design.FriendlyName</h5>
                        <p class="card-text">@design.Config</p>
                        <p class="card-text">@design.Device</p>
                    </div>
                    <div class="card-footer">
                        <a href="@($"/edit/{design.Name}")" class="btn btn-primary">Edit</a>
                    </div>
                </div>
            </div>
            }
        </div>
    </div>
}

<AddPanelModal OnPanelAdded="PanelAdded" />

@code {
    [PersistentState]
    public DesignInfo[]? Designs { get; set; }

    protected override async Task OnInitializedAsync()
    {
        Designs = await PanelDesignsProvider.GetDesignInfos();
    }

    private void PanelAdded(DesignInfo designInfo)
    {
        Designs = Designs?.Append(designInfo).ToArray();
    }
}