@page "/edit/{designName}"
@using HomePanel.Builder.Client.Components
@using HomePanel.Builder.Client.Services
@attribute [StreamRendering]
@inject IPanelDesignsProvider PanelDesignsProvider
<PageTitle>@DesignName - Home Panel Builder</PageTitle>
<h3>Panel Designer</h3>
<div class="list-group">
    <button type="button" class="list-group-item list-group-item-action active" aria-current="true">
        <Icon Id="mdi:home" />The current button
    </button>
    <button type="button" class="list-group-item list-group-item-action">
        <Icon Id="mdi:account" />A second button item
    </button>
    <button type="button" class="list-group-item list-group-item-action">
        <Icon Id="mdi:bell" />A third button item
    </button>
    <button type="button" class="list-group-item list-group-item-action">
        <Icon Id="mdi:calendar" />A fourth button item
    </button>
    <button type="button" class="list-group-item list-group-item-action" disabled>
        <Icon Id="mdi:close" />A disabled button item
    </button>
</div>